\@writefile{toc}{\contentsline {section}{\numberline {3}다른 관점: Type S, Type M error}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 두 sampling distribution. 진짜 효과가 0인데도, SE가 큰 경우(파란 곡선) ``유의''로 판정되는 결과는 진짜 효과로부터 크게 떨어진 값일 가능성이 높다.\relax }}{3}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 시뮬레이션: 진짜 효과 = 2일 때 SE의 함수로 본 power, Type S, Type M. SE가 커질수록 (저전력 상황) Type S와 Type M 모두 폭증한다. Bonferroni 보정은 사실상 SE를 ``더 크게 만드는 효과''와 같으므로 이 문제를 \emph  {악화}시킨다.\relax }}{4}{figure.caption.3}\protected@file@percent }
